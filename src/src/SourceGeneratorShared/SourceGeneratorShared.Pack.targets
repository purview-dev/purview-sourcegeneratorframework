<Project>
	<!--
		Shared NuGet packaging for projects that depend on the SourceGeneratorShared assembly.

		IncludeSourceGeneratorShared packs the Shared assembly (and its XML docs) into lib/<tfm>/
		alongside the project's own build output, since the project's assembly references it at runtime.

		IncludeSourceGeneratorSharedSymbols routes the Shared PDB into the .snupkg only.
		TfmSpecificPackageFile entries are treated as regular package content and land in both the
		.nupkg and the .snupkg, so the PDB is delivered through TfmSpecificDebugSymbolsFile instead.

		Both targets are registered by the importing project via TargetsForTfmSpecificContentInPackage
		and TargetsForTfmSpecificDebugSymbolsInPackage respectively.
	-->
	<Target Name="IncludeSourceGeneratorShared">
		<MSBuild
			Projects="$(MSBuildThisFileDirectory)SourceGeneratorShared.csproj"
			Targets="GetTargetPath"
			Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_SourceGeneratorSharedAssembly" />
		</MSBuild>

		<ItemGroup>
			<_SourceGeneratorSharedPackageFile Include="@(_SourceGeneratorSharedAssembly)" />
			<_SourceGeneratorSharedPackageFile Include="@(_SourceGeneratorSharedAssembly->'%(RootDir)%(Directory)%(Filename).xml')" />

			<TfmSpecificPackageFile
				Include="@(_SourceGeneratorSharedPackageFile)"
				Condition="Exists('%(_SourceGeneratorSharedPackageFile.Identity)')"
			>
				<PackagePath>lib/$(TargetFramework)/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

	<!--
		This file is imported (rather than inlined in the .csproj) so that the literal
		<TargetFramework> metadata element cannot trip the SDK's text-based TargetFramework
		declaration detection on the importing project file.
	-->
	<Target Name="IncludeSourceGeneratorSharedSymbols">
		<MSBuild
			Projects="$(MSBuildThisFileDirectory)SourceGeneratorShared.csproj"
			Targets="GetTargetPath"
			Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_SourceGeneratorSharedAssembly" />
		</MSBuild>

		<ItemGroup>
			<_SourceGeneratorSharedSymbolFile Include="@(_SourceGeneratorSharedAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />

			<TfmSpecificDebugSymbolsFile
				Include="@(_SourceGeneratorSharedSymbolFile)"
				Condition="Exists('%(_SourceGeneratorSharedSymbolFile.Identity)')"
			>
				<TargetFramework>$(TargetFramework)</TargetFramework>
			</TfmSpecificDebugSymbolsFile>
		</ItemGroup>
	</Target>
</Project>
