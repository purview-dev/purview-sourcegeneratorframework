<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework>netstandard2.0</TargetFramework>
		<IsPackable>true</IsPackable>
		<!-- This library is loaded inside the compiler alongside the generator, but it must
		     remain normal package build output and therefore is not an IsRoslynComponent. -->
		<DisableSourceLink>true</DisableSourceLink>
		<NoWarn>$(NoWarn);CS1591;</NoWarn>
		<AssemblyName>$(RootNamespace)</AssemblyName>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeSourceGeneratorShared</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference
			Include="..\SourceGeneratorFramework.Generators\SourceGeneratorFramework.Generators.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer"
			Targets="GetSourceGeneratorAnalyzerFiles"
		/>
		<ProjectReference
			Include="..\SourceGeneratorShared\SourceGeneratorShared.csproj"
			PrivateAssets="all"
			Pack="false"
		/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
	</ItemGroup>

	<Target Name="IncludeSourceGeneratorShared">
		<MSBuild
			Projects="..\SourceGeneratorShared\SourceGeneratorShared.csproj"
			Targets="GetTargetPath"
			Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0"
		>
			<Output TaskParameter="TargetOutputs" ItemName="_SourceGeneratorSharedAssembly" />
		</MSBuild>

		<ItemGroup>
			<_SourceGeneratorSharedPackageFile Include="@(_SourceGeneratorSharedAssembly)" />
			<_SourceGeneratorSharedPackageFile Include="@(_SourceGeneratorSharedAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
			<_SourceGeneratorSharedPackageFile Include="@(_SourceGeneratorSharedAssembly->'%(RootDir)%(Directory)%(Filename).xml')" />

			<TfmSpecificPackageFile
				Include="@(_SourceGeneratorSharedPackageFile)"
				Condition="Exists('%(_SourceGeneratorSharedPackageFile.Identity)')"
			>
				<PackagePath>lib/$(TargetFramework)/</PackagePath>
			</TfmSpecificPackageFile>

			<TfmSpecificPackageFile
				Include="@(_SourceGeneratorSharedPackageFile)"
				Condition="'%(Filename)%(Extension)' != 'Purview.SourceGeneratorFramework.Shared.dll' AND Exists('%(_SourceGeneratorSharedPackageFile.Identity)')"
			>
				<PackagePath>analyzers/dotnet/cs/</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>
</Project>
